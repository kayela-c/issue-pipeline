# Server-side only. Nothing in this file reaches the browser bundle.

# Neon Postgres. Use the pooled connection string for the branch you are on.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Stage 1 AI provider ------------------------------------------------------
# The TEAM DEFAULT provider. Each user can pick their own provider, models, and
# API key in Settings; users who haven't use this. Switch by changing this one
# line, then restart `pnpm dev` (or change the Netlify env var and redeploy).
# A provider's key and models below are also the fallback for users who pick
# that provider in Settings without adding their own key.
#   anthropic  Anthropic API (ANTHROPIC_API_KEY)
#   gemini     Google Gemini API (GOOGLE_API_KEY from Google AI Studio)
#   openai     OpenAI API (OPENAI_API_KEY)
#   grok       xAI API (XAI_API_KEY)
#   venice     Venice API (VENICE_API_KEY)
#   lmstudio   a model in LM Studio 0.4.1+ on this machine (local only; also a Settings choice)
LLM_PROVIDER=anthropic

# Encrypts API keys users save in Settings: 32 random bytes, base64 (generate
# like SESSION_SECRET below). Losing or changing it makes saved keys unreadable
# (users are asked to add them again). Use different values per environment.
CREDENTIALS_KEY=
# Optional, during key rotation: the old key, still accepted for decryption.
# CREDENTIALS_KEY_PREVIOUS=

# Anthropic. Models default to these ids when unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SELECT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5

# Gemini. Models default to these ids when unset.
GOOGLE_API_KEY=
GEMINI_MODEL_SELECT=gemini-3.5-flash-lite
GEMINI_MODEL_DRAFT=gemini-3.8-flash

# OpenAI, xAI (Grok), and Venice have no built-in model ids: set models here
# for the team, or users choose them in Settings (listed live from the provider).
OPENAI_API_KEY=
OPENAI_MODEL_SELECT=
OPENAI_MODEL_DRAFT=
XAI_API_KEY=
XAI_MODEL_SELECT=
XAI_MODEL_DRAFT=
VENICE_API_KEY=
VENICE_MODEL_SELECT=
VENICE_MODEL_DRAFT=

# LM Studio (Anthropic-compatible endpoint). Each user can also set these in
# Settings > AI model while the app runs locally; the values below are the
# fallback. Model ids are required: see
# GET http://localhost:1234/v1/models. Set the context length the model is
# loaded with; prompts are sized to fit it.
# LMSTUDIO_BASE_URL=http://localhost:1234
# LMSTUDIO_API_KEY=              # only if "Require Authentication" is on
LMSTUDIO_MODEL_SELECT=
LMSTUDIO_MODEL_DRAFT=
LMSTUDIO_CONTEXT_TOKENS=8192
LMSTUDIO_MAX_OUTPUT_TOKENS=4096

# Optional cap on drafting output for any provider.
# LLM_MAX_OUTPUT_TOKENS=

# Gitea instance the API reads and posts to.
GITEA_BASE_URL=
# Org short name (not its URL). Only its members may use the app.
GITEA_ALLOWED_ORG=

# Gitea OAuth2 application. Register it as a CONFIDENTIAL client with redirect
# URIs for every origin you sign in from, e.g.
#   http://localhost:8888/api/auth/callback
#   https://<production-site>/api/auth/callback
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=

# GitHub OAuth App, used only for sign-in identity (read:user scope; no repo
# access). Register its callback URL the same way:
#   http://localhost:8888/api/auth/github/callback
#   https://<production-site>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed to sign in or link (case-insensitive).
# Empty or unset means nobody -- the button is shown but every attempt fails.
GITHUB_ALLOWED_USERS=

# Encrypts the session cookie: 32 random bytes, base64. Changing it signs
# everyone out. Use different values per environment. PowerShell:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
SESSION_SECRET=
# Optional, during key rotation: the old key, still accepted for decryption.
# SESSION_SECRET_PREVIOUS=
# Absolute session lifetime in days.
SESSION_MAX_AGE_DAYS=7

# Shared secret guarding /internal/* background-function endpoints.
INTERNAL_JOB_SECRET=

# Cost guard on Stage 1.
MAX_RUNS_PER_USER_PER_DAY=50
