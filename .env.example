# Neon Postgres. Use the pooled connection string for the branch you are on.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Stage 1 drafting only. Never reaches the desktop client.
ANTHROPIC_API_KEY=

# Model ids are env-configurable so they can be rolled without a deploy.
MODEL_SELECT=claude-haiku-4-5-20251001
MODEL_DRAFT=claude-sonnet-5

# Gitea instance the API reads and posts to.
GITEA_BASE_URL=
# Only members of this org may use the API.
GITEA_ALLOWED_ORG=

# Shared secret guarding /internal/* background-function endpoints.
INTERNAL_JOB_SECRET=

# Cost guard on Stage 1.
MAX_RUNS_PER_USER_PER_DAY=50
